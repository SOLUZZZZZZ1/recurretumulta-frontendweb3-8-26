    "@babel/parser": "7.28.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.27",
    "tailwindcss": "3.4.19",
    "vite": "8.2.2"
  }
}
